# Norwegian Høringer MCP Server — environment variables
# Copy this file to .env and fill in your values

# Optional: set a JWT secret to require token auth on all MCP requests.
# Leave blank to run without authentication (suitable when protected by VPN/firewall).
MCP_SERVER_JWT_SECRET=

# Optional: restrict JWT validation to a specific issuer and audience.
MCP_SERVER_JWT_ISSUER=
MCP_SERVER_JWT_AUDIENCE=
